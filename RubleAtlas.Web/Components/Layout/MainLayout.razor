@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />

<div class="page">
    <div class="top-row">
        <NavMenu />
    </div>

    <main>
        <article class="content">
            @Body
        </article>

        <div class="bottom-row px-4">
            <div class="source-text">Data source: <b>Bank of Russia</b></div>
            <a href="https://github.com/nahmaida/TheRubleAtlas/" target="_blank">About</a>
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
