@using RubleAtlas.Infrastructure.Storage.JSON
@using RubleAtlas.Domain
@inject JSONStorage Storage

<div class="map-host">
    <RealTimeMap Parameters="parameters" height="100vh" width="100vw" @ref="_map"></RealTimeMap>
</div>

@code {
    private RealTimeMap? _map;
    private bool _markersAdded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _markersAdded || _map is null) return;

        Console.WriteLine("Map rendering...");

        await Task.Delay(1000);

        List<Banknote> banknotes = Storage.GetBanknotes();
        await AddMarkers(banknotes);

        _markersAdded = true;
    }

    private async Task AddMarkers(List<Banknote> banknotes)
    {
        if (_map is null) return;

        // keep view stable while adding
        _map.Geometric.Points.changeExtentWhenAddPoints = false;

        foreach (var banknote in banknotes)
        {
            await _map.Geometric.Points.add(new RealTimeMap.StreamPoint
            {
                guid = Guid.NewGuid(),
                type = "banknote",
                value = banknote.Name,
                latitude = banknote.ObversePlace.Latitude,
                longitude = banknote.ObversePlace.Longitude
            });

            await _map.Geometric.Points.add(new RealTimeMap.StreamPoint
            {
                guid = Guid.NewGuid(),
                type = "banknote",
                value = banknote.Name,
                latitude = banknote.ReversePlace.Latitude,
                longitude = banknote.ReversePlace.Longitude
            });
        }

        Console.WriteLine("Markers loaded");
    }

    RealTimeMap.LoadParameters parameters = new RealTimeMap.LoadParameters()  //general map settings
    {
        location = new RealTimeMap.Location()
        {
            // Centered on siberia
            latitude = 62.3842861,
            longitude = 93.2561458,
        },
        // Most of russia is visible
        zoomLevel = 4,

        defaultAttribution = new RealTimeMap.DefaultAttribution
        {
            has = true,
            // Don't remove
            // Removes the default ukrainian flag to avoid legal trouble
            defaultHtmlContent = "© OpenStreetMap"
        },
    };

    RealTimeMap.PointSymbol symbol = new RealTimeMap.PointSymbol()
    {
        color = "red",
        fillColor = "yellow",
        radius = 10,
        weight = 3,
        opacity = 1,
        fillOpacity = 1
    };
    bool run = false;
}
