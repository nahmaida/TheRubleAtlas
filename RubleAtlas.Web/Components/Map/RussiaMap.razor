@using RubleAtlas.Infrastructure.Storage.JSON
@using RubleAtlas.Domain
@using RubleAtlas.Web.Components.InfoMenu
@inject JSONStorage Storage

<div class="map-host">
    <RealTimeMap Parameters="parameters" height="100vh" width="100vw" @ref="_map" OnAfterMapLoaded="OnAfterMapLoaded" OnZoomLevelEndChange="OnZoomLevel" OnMouseDownMap="OnMouseDownMap"></RealTimeMap>

    @if (_selectedNote != null)
    {
        <div class="note-panel" @onclick:stopPropagation="true">
            <InfoMenu Banknote="_selectedNote" Place="_selectedPlace" Open="true"></InfoMenu>
        </div>
    }
</div>

@code {
    private RealTimeMap? _map;
    private bool _markersAdded;
    private const int defaultZoom = 4;
    private int _zoom = defaultZoom; // Current zoom level
    private int _symbolRadiusPx = 7; // Point radius
    private Banknote? _selectedNote = null; // current selected note (for info menu)
    private Place? _selectedPlace = null; // selected place

    /// <summary>
    /// Updates the zoom level variable
    /// </summary>
    public async Task OnZoomLevel(RealTimeMap.MapZoomEventArgs args)
    {
        _zoom = args.zoomLevel;
    }

    /// <summary>
    /// Begins adding markers after map is loaded
    /// </summary>
    private async Task OnAfterMapLoaded(RealTimeMap.MapEventArgs args)
    {
        if (_markersAdded || _map is null) return;

        Console.WriteLine("Map rendering...");

        await Task.Delay(1000);

        List<Banknote> banknotes = Storage.GetBanknotes();
        await AddMarkers(args, banknotes);
        Console.WriteLine("Markers loaded");

        _markersAdded = true;
    }

    /// <summary>
    /// Adds StreamPoint to map for every banknote location
    /// </summary>
    private async Task AddMarkers(RealTimeMap.MapEventArgs args, List<Banknote> banknotes)
    {
        if (_map is null) return;

        // keep view stable while adding
        _map.Geometric.Points.changeExtentWhenAddPoints = false;

        foreach (var banknote in banknotes)
        {
            string type = banknote.Name;

            SetPointsAppearance(args, banknote);

            foreach (var place in banknote.ObversePlaces)
            {
                await _map.Geometric.Points.add(new RealTimeMap.StreamPoint
                {
                    guid = Guid.NewGuid(),
                    type = type,
                    value = banknote.Name,
                    latitude = place.Latitude,
                    longitude = place.Longitude
                });
            }

            foreach (var place in banknote.ReversePlaces)
            {
                await _map.Geometric.Points.add(new RealTimeMap.StreamPoint
                {
                    guid = Guid.NewGuid(),
                    type = type,
                    value = banknote.Name,
                    latitude = place.Latitude,
                    longitude = place.Longitude
                });
            }
        }
    }

    /// <summary>
    /// Sets the color, size, tooltip etc. for points based on banknote
    /// </summary>
    private void SetPointsAppearance(RealTimeMap.MapEventArgs args, Banknote note)
    {
        string type = note.Name;
        string fillColor = note.Color;
        int value = note.Denomination;
        int year = note.Year;

        // Style all banknote points of this type
        args.sender.Geometric.Points.AppearanceOnType(p => p.type == type).pattern =
            new RealTimeMap.PointSymbol
            {
                fillColor = fillColor,
                color = "#1f1f1f",     // outline
                radius = _symbolRadiusPx,
                weight = 2,
                fillOpacity = 0.9,
                opacity = 1
            };

        args.sender.Geometric.Points.AppearanceOnType(p => p.type == type).pattern =
        new RealTimeMap.PointTooltip
        {
            content = $"<b>{value}₽</b> {year}",
            permanent = false,
            opacity = 0.9
        };

        Console.WriteLine("Markers colored");
    }

    /// <summary>
    /// Sets _selected if clicking a point
    /// </summary>
    private async Task OnMouseDownMap(RealTimeMap.ClicksMapArgs args)
    {
        if (_map == null) return;

        double lattitude = args.location.latitude;
        double clickPaddingMeters = MetersPerPixel(lattitude, _zoom) * _symbolRadiusPx;

        var clicked = new RealTimeMap.StreamPoint
        {
            latitude = args.location.latitude,
            longitude = args.location.longitude
        };

        var nearest = _map.Geometric.Points
            .getItems(p => _map.Geometric.Computations.distance(p, clicked, RealTimeMap.UnitOfMeasure.meters) <= clickPaddingMeters)
            .OrderBy(p => _map.Geometric.Computations.distance(p, clicked, RealTimeMap.UnitOfMeasure.meters))
            .FirstOrDefault();

        if (nearest is null)
        {
            return;
        }

        Banknote? note = Storage.GetBanknoteByType(nearest.type);
        double latitude = nearest.latitude;
        double longitude = nearest.longitude;
        Place? place = note.GetPlaceByCoordinates(latitude, longitude);

        if (note != null && place != null)
        {
            _selectedNote = note;
            _selectedPlace = place;
        }
    }

    /// <summary>
    /// Calculates the number of meters in one pixel
    /// with current zoomLevel at given lattitude
    /// </summary>
    private static double MetersPerPixel(double latitudeDeg, int zoomLevel)
    {
        // ground resolution (m/px) for WebMercator-style tiling
        return 156543.04 * Math.Cos(latitudeDeg * Math.PI / 180.0) / Math.Pow(2, zoomLevel);
    }

    RealTimeMap.LoadParameters parameters = new RealTimeMap.LoadParameters()  //general map settings
    {
        location = new RealTimeMap.Location()
        {
            // Centered on siberia
            latitude = 62.3842861,
            longitude = 93.2561458,
        },
        // Most of russia is visible
        zoomLevel = defaultZoom,

        defaultAttribution = new RealTimeMap.DefaultAttribution
        {
            has = true,
            // Don't remove
            // Removes the default ukrainian flag to avoid legal trouble
            defaultHtmlContent = "© OpenStreetMap"
        }
    };

    bool run = false;
}
