@using RubleAtlas.Infrastructure.Storage.JSON
@using RubleAtlas.Domain
@inject JSONStorage Storage

<div class="map-host">
    <RealTimeMap Parameters="parameters" height="100vh" width="100vw" @ref="_map" OnAfterMapLoaded="OnAfterMapLoaded"></RealTimeMap>
</div>

@code {
    private RealTimeMap? _map;
    private bool _markersAdded;

    private async Task AddMarkers(RealTimeMap.MapEventArgs args, List<Banknote> banknotes)
    {
        if (_map is null) return;

        // keep view stable while adding
        _map.Geometric.Points.changeExtentWhenAddPoints = false;

        foreach (var banknote in banknotes)
        {
            string type = banknote.Name;

            string fillColor = banknote.Color;

            SetPointsAppearance(args, fillColor, banknote);

            foreach (var place in banknote.ObversePlaces)
            {
                await _map.Geometric.Points.add(new RealTimeMap.StreamPoint
                {
                    guid = Guid.NewGuid(),
                    type = type,
                    value = banknote.Name,
                    latitude = place.Latitude,
                    longitude = place.Longitude
                });
            }

            foreach (var place in banknote.ReversePlaces)
            {
                await _map.Geometric.Points.add(new RealTimeMap.StreamPoint
                {
                    guid = Guid.NewGuid(),
                    type = type,
                    value = banknote.Name,
                    latitude = place.Latitude,
                    longitude = place.Longitude
                });
            }
        }
    }

    private async Task OnAfterMapLoaded(RealTimeMap.MapEventArgs args)
    {
        if (_markersAdded || _map is null) return;

        Console.WriteLine("Map rendering...");

        await Task.Delay(1000);

        List<Banknote> banknotes = Storage.GetBanknotes();
        await AddMarkers(args, banknotes);
        Console.WriteLine("Markers loaded");

        _markersAdded = true;
    }

    void SetPointsAppearance(RealTimeMap.MapEventArgs args, string fillColor, Banknote note)
    {
        string type = note.Name;
        int value = note.Denomination;
        int year = note.Year;

        // Style all banknote points of this type
        args.sender.Geometric.Points.AppearanceOnType(p => p.type == type).pattern =
            new RealTimeMap.PointSymbol
            {
                fillColor = fillColor,
                color = "#1f1f1f",     // outline
                radius = 7,
                weight = 2,
                fillOpacity = 0.9,
                opacity = 1
            };

        args.sender.Geometric.Points.AppearanceOnType(p => p.type == type).pattern =
        new RealTimeMap.PointTooltip
        {
            content = $"<b>{value}₽</b> {year}",
            permanent = false,
            opacity = 0.9
        };

        Console.WriteLine("Markers colored");
    }


    RealTimeMap.LoadParameters parameters = new RealTimeMap.LoadParameters()  //general map settings
    {
        location = new RealTimeMap.Location()
        {
            // Centered on siberia
            latitude = 62.3842861,
            longitude = 93.2561458,
        },
        // Most of russia is visible
        zoomLevel = 4,

        defaultAttribution = new RealTimeMap.DefaultAttribution
        {
            has = true,
            // Don't remove
            // Removes the default ukrainian flag to avoid legal trouble
            defaultHtmlContent = "© OpenStreetMap"
        }
    };

    bool run = false;
}
