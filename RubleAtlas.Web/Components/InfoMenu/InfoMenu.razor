@using RubleAtlas.Domain
@using Microsoft.Extensions.Localization
@using RubleAtlas.Infrastructure.Storage.Markdown
@using RubleAtlas.Web.Components.Articles
@using Markdig
@inject ArticleProvider ArticleService
@inject IStringLocalizer<RubleAtlas.Infrastructure.Localization.SharedResource> L

<aside class="position-fixed d-flex flex-column gap-3 infomenu @( Open ? "" : "d-none")"
       role="dialog"
       aria-labelledby="popupTitle">
    
    <button type="button" class="btn-close closeinfomenu" aria-label="Close" @onclick="ToggleOpen"></button>
    
    <h2 id="popupTitle" class="h5 m-0 pe-5 font-weight-600" style="color: #202124; letter-spacing: -0.01em;">
        @L[@Banknote.Name]
    </h2>

    <div class="note3d bg-light">
        <RubleAtlas.Web.Components._3DNoteView._3DNoteView @key="Place.LandmarkKey" Banknote="Banknote"></RubleAtlas.Web.Components._3DNoteView._3DNoteView>
    </div>

    <div class="btn w-100" @onclick="() => OpenBanknote(Banknote)" style="background-color: #3e7758; color: white; border-radius: 12px; font-weight: 500; transition: background 0.2s;">
        @L["Read_More"]
    </div>

    <hr class="my-1" style="border-top: 1px solid rgba(0,0,0,0.06);">

    <div class="cardBox">
        <PlaceCard Place="Place" />
    </div>
</aside>

<BanknoteModal @bind-IsVisible="isNoteOpen" Banknote="Banknote">
    <ChildContent>
        @((MarkupString)renderedHtml)
    </ChildContent>
</BanknoteModal>


@code {
    [Parameter]
    public Banknote Banknote { get; set; }
    [Parameter]
    public Place Place { get; set; }
    [Parameter]
    public EventCallback OnClose { get; set; }
    [Parameter]
    public bool Open { get; set; }
    private bool isNoteOpen = false;
    private string renderedHtml = "";

    private void ToggleOpen()
    {
        Open = !Open;
        if (!Open) OnClose.InvokeAsync();
    }

    private async Task OpenBanknote(Banknote note)
    {
        var culture = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
        // Uses the ID from data.json (e.g., "Landmark.RUB5.1997.Obverse.SophiaCathedral")
        var markdown = await ArticleService.GetArticleAsync("Banknotes", note.Name, culture);
        renderedHtml = Markdig.Markdown.ToHtml(markdown);
        isNoteOpen = true;
    }
}
}
