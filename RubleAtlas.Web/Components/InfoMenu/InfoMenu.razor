@using RubleAtlas.Domain
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<RubleAtlas.Infrastructure.Localization.SharedResource> L

<aside class="position-fixed bg-white shadow rounded-4 p-3 d-flex flex-column gap-3 infomenu @( Open ? "" : "d-none")"
       role="dialog"
       aria-labelledby="popupTitle">
    <button type="button" class="btn-close closeinfomenu" aria-label="Close" @onclick="ToggleOpen"></button>
    <h2 id="popupTitle" class="h5 m-0">@L[@Banknote.Name]</h2>

    <div class="border note3d rounded-3 bg-light">
        <RubleAtlas.Web.Components._3DNoteView._3DNoteView @key="Place.LandmarkKey" Banknote="Banknote"></RubleAtlas.Web.Components._3DNoteView._3DNoteView>
    </div>

    <NavLink class="btn btn-dark w-100" href="banknotes">
        @L["Read_More"]
    </NavLink>

    <hr class="my-1">

    <h3 class="h6 m-0"></h3>

    <div class="cardBox">
        <PlaceCard Place="Place" />
    </div>

    <p class="small text-secondary m-0">
        Lorem ipsum something something
    </p>
</aside>



@code {
    [Parameter]
    public Banknote Banknote { get; set; }
    [Parameter]
    public Place Place { get; set; }
    [Parameter]
    public EventCallback OnClose { get; set; }
    [Parameter]
    public bool Open { get; set; }

    private void ToggleOpen()
    {
        Open = !Open;
        if (!Open) OnClose.InvokeAsync();
    }
}
