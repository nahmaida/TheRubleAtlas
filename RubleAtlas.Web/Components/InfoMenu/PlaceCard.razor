@using RubleAtlas.Domain
@using Microsoft.Extensions.Localization
@using RubleAtlas.Infrastructure.Storage.Markdown
@using RubleAtlas.Web.Components.Articles
@using Markdig
@inject ArticleProvider ArticleService
@inject IStringLocalizer<RubleAtlas.Infrastructure.Localization.SharedResource> L

<div class="place-card-wrapper h-100 w-100">
    <Card Class="placeCard h-100" Color="CardColor.Dark" TextAlignment="Alignment.Center" Style="@(
            $"background-image: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.9) 100%), url('/images/places/{Place.LandmarkKey}.webp');" +
            "background-size:cover;" + "background-position:center;"
         )">
    <CardBody>
        >
            <CardTitle>@L[@Place.CityKey]: @L[@Place.LandmarkKey]</CardTitle>
        </CardBody>
        <CardFooter Class="bg-transparent border-0 pb-3">
            <div class="goButton">
                <Button Color="ButtonColor.Warning" @onclick="() => OpenPlace()" Type="ButtonType.Link">@L["GoToPlace"]</Button>
            </div>
        </CardFooter>
    </Card>
</div>

<PlaceModal @bind-IsVisible="isPlaceOpen"
            PlaceName="@L[@Place.LandmarkKey]"
            ImageUrl="@($"/images/places_wide/{Place.LandmarkKey}.webp")">
    <ChildContent>
        @((MarkupString)renderedHtml)
    </ChildContent>
</PlaceModal>

@code {
    [Parameter]
    public Place Place { get; set; } = default!;
    private bool isPlaceOpen = false;
    private string renderedHtml = "";

    private async Task OpenPlace()
    {
        var culture = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
        // Uses the ID from data.json
        var markdown = await ArticleService.GetArticleAsync("Places", Place.LandmarkKey, culture);
        renderedHtml = Markdig.Markdown.ToHtml(markdown);
        isPlaceOpen = true;
    }
}