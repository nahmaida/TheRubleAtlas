@using RubleAtlas.Domain
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<RubleAtlas.Infrastructure.Localization.SharedResource> L

<MudCard Class="mb-4 placeCard h-100" 
         Elevation="0"
         Style="@(
            $"background-image: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.9) 100%), url('/images/places/{Place.LandmarkKey}.webp');" +
            "background-size:cover;" +
            "background-position:center; " +
            "color: white;"
         )">
    <MudCardContent>
        <MudText Typo="Typo.h6" Align="Align.Center" Style="font-size: 16px;">
            @L[@Place.CityKey]: @L[@Place.LandmarkKey]
        </MudText>
    </MudCardContent>

    @* MudCardActions replaces CardFooter; justify-center aligns the button  *@
    <MudCardActions Class="justify-center pb-3">
        <div class="goButton">
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Warning" 
                       Href="#" 
                       Target="_self">
                @L["GoToPlace"]
            </MudButton>
        </div>
    </MudCardActions>
</MudCard>

@code {
    [Parameter]
    public Place Place { get; set; }
}