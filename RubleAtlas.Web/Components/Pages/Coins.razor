@page "/coins"
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<RubleAtlas.Infrastructure.Localization.SharedResource> L

<PageTitle>@L["Coins_Page_Title_Long"]</PageTitle>

<div class="coins-container">
    <div class="coins-inner">
        <!-- Hero Header -->
        <header class="coins-hero">
            <h1>@L["Coins_Hero_Title"]</h1>
            <p class="subtitle">@L["Coins_Hero_Subtitle"]</p>
        </header>

        <!-- Core Denominations Grid -->
        <section class="section-block">
            <h2 class="section-title">@L["Circulating_Denominations"]</h2>
            <div class="denominations-grid">
                <div class="coin-card c-1">
                    <div class="coin-disc">1₽</div>
                    <h3>@L["Denom_1_Ruble"]</h3>
                    <p>@L["Material_Nickel_Steel"]</p>
                </div>
                <div class="coin-card c-2">
                    <div class="coin-disc">2₽</div>
                    <h3>@L["Denom_2_Rubles"]</h3>
                    <p>@L["Material_Nickel_Steel"]</p>
                </div>
                <div class="coin-card c-5">
                    <div class="coin-disc">5₽</div>
                    <h3>@L["Denom_5_Rubles"]</h3>
                    <p>@L["Material_Nickel_Steel"]</p>
                </div>
                <div class="coin-card c-10">
                    <div class="coin-disc">10₽</div>
                    <h3>@L["Denom_10_Rubles"]</h3>
                    <p>@L["Material_Brass_Steel"]</p>
                </div>
            </div>
        </section>

        <!-- Anatomy Feature Split -->
        <section class="anatomy-row">
            <div class="feature-card">
                <div class="badge">@L["Badge_Design_Feature"]</div>
                <h2>@L["Feature_Mintmarks_Title"]</h2>
                <p>@L["Feature_Mintmarks_Desc"]</p>
                <ul class="feature-list">
                    <li><strong>MMD</strong> — @L["Mint_Moscow"]</li>
                    <li><strong>SPMD</strong> — @L["Mint_StPetersburg"]</li>
                </ul>
            </div>

            <div class="feature-card highlighted">
                <div class="badge accent">@L["Badge_Historical_Shift"]</div>
                <h2>@L["Feature_Eagle_Title"]</h2>
                <p>@L["Feature_Eagle_Desc"]</p>
            </div>
        </section>
    </div>
</div>