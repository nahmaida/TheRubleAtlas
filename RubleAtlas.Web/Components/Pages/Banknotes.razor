@page "/banknotes"
@rendermode InteractiveServer
@using RubleAtlas.Domain
@using RubleAtlas.Infrastructure.Storage.JSON
@using RubleAtlas.Infrastructure.Storage.Markdown
@using RubleAtlas.Web.Components.Articles
@using RubleAtlas.Web.Components.InfoMenu
@using Microsoft.Extensions.Localization
@using Markdig
@inject ArticleProvider ArticleService
@inject IStringLocalizer<RubleAtlas.Infrastructure.Localization.SharedResource> L
@inject JSONStorage Storage
@inject NavigationManager NavManager

<PageTitle>@L["ExploreBanknotes"]</PageTitle>

<div class="scroll-wrapper">
    <div class="container-fluid py-5 px-3 px-md-4 px-lg-5">
        <div class="text-center mb-5">
            <h1 class="display-5 fw-bold text-dark mb-2 tracking-tight">@L["ExploreBanknotes"]</h1>
            <p class="text-muted fs-5">@L["ExploreBanknotesSubtitle"]</p>
        </div>

        @if (banknotes == null)
        {
            <div class="d-flex justify-content-center align-items-center" style="min-height: 40vh;">
                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                    <span class="visually-hidden">@L["Loading"]</span>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4 justify-content-center">
                @foreach (var note in banknotes)
                {
                    <div class="col-12 col-xl-10">
                        <div class="banknote-card"
                             style="background: linear-gradient(-135deg, #ffffff 40%, @note.Color 140%);"
                             @onclick="() => OpenBanknote(note)">
                
                            <div class="card-content-wrapper">
                                <div class="banknote-visual">
                                    <img src="/images/banknotes/rub-@note.Denomination-@note.Year-obverse.jpg"
                                         alt="@string.Format(L["RubleBanknoteAlt"].Value, note.Denomination)"
                                         class="banknote-img" />
                        
                                    <div class="explore-action">
                                        <span class="explore-text">@L["ViewDetails"]</span>
                                        <i class="bi bi-arrow-right-short fs-4"></i>
                                    </div>
                                </div>

                                <div class="banknote-details">
                                    <div class="details-header">
                                        <div>
                                            <h2 class="denomination-title">@note.Denomination ₽</h2>
                                            <span class="badge rounded-pill text-bg-light border text-secondary fw-medium px-3 py-2">
                                                @string.Format(L["SeriesFormat"].Value, note.Year)
                                            </span>
                                        </div>
                                    </div>
                        
                                    <h6 class="carousel-heading text-uppercase text-muted fw-bold tracking-wide mt-4 mb-3">
                                        @L["FeaturedLandmarks"]
                                    </h6>
                        
                                    <div class="carousel-container">
                                        <div class="carousel" @onclick:stopPropagation="true">
                                            @if (note.ObversePlaces != null)
                                            {
                                                @foreach (var place in note.ObversePlaces)
                                                {
                                                    <div class="carousel-item-modern">
                                                        <PlaceCard Place="@place" />
                                                    </div>
                                                }
                                            }
                                            @if (note.ReversePlaces != null)
                                            {
                                                @foreach (var place in note.ReversePlaces)
                                                {
                                                    <div class="carousel-item-modern">
                                                        <PlaceCard Place="@place" />
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <!-- Special Banknotes Section -->
            <div class="row g-4 justify-content-center mt-5">
                
                <!-- Vertical Commemorative Notes -->
                <div class="col-12 col-xl-5">
                    <div class="banknote-card text-center h-100" style="background: linear-gradient(-135deg, #ffffff 40%, #209985 140%);">
                        <h4 class="fw-bold mb-4 tracking-tight">@L["CommemorativeNotes"]</h4>
                        <div class="d-flex justify-content-center gap-5 gap-md-4 flex-wrap">
                            
                            <div class="special-note-wrapper vertical">
                                <img src="/images/banknotes/rub-100-2014-alt-obverse.jpg"
                                     class="special-note-img vertical-note"
                                     alt="100 Rubles 2014 Sochi"
                                     @onclick='() => OpenSpecialNote("rub-100-2014-alt", 100, 2014)' />
                                <span class="special-note-title">100 ₽<br /><small>@L["Sochi2014"]</small></span>
                            </div>
                            
                            <div class="special-note-wrapper vertical">
                                <img src="/images/banknotes/rub-100-2015-alt-obverse.jpg"
                                     class="special-note-img vertical-note"
                                     alt="100 Rubles 2015 Crimea"
                                     @onclick='() => OpenSpecialNote("rub-100-2015-alt", 100, 2015)' />
                                <span class="special-note-title">100 ₽<br /><small>@L["Crimea2015"]</small></span>
                            </div>
                            
                            <div class="special-note-wrapper vertical">
                                <img src="/images/banknotes/rub-100-2018-alt-obverse.jpg"
                                     class="special-note-img vertical-note"
                                     alt="100 Rubles 2018 World Cup"
                                     @onclick='() => OpenSpecialNote("rub-100-2018-alt", 100, 2018)' />
                                <span class="special-note-title">100 ₽<br /><small>@L["WorldCup2018"]</small></span>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Lost Banknotes -->
                <div class="col-12 col-xl-5">
                    <div class="banknote-card text-center h-100" style="background: linear-gradient(-135deg, #ffffff 40%, #a68371 140%);">
                        <h4 class="fw-bold mb-4 tracking-tight">@L["LostBanknotes"]</h4>
                        <!-- Flex container aligning items to the right -->
                        <div class="d-flex flex-column gap-4 align-items-end pe-xl-3">
                            
                            <div class="special-note-wrapper horizontal">
                                <div class="text-end pe-4">
                                    <h2 class="denomination-title">1000 ₽</h2>
                                    <span class="badge rounded-pill text-bg-light border text-secondary fw-medium px-3 py-2">
                                        @string.Format(L["SeriesFormat"].Value, 1995)
                                    </span>
                                </div>
                                <img src="/images/banknotes/rub-1000-1995-alt-obverse.jpg"
                                     class="special-note-img horizontal-note"
                                     alt="1000 Rubles 1995"
                                     @onclick='() => OpenSpecialNote("rub-1000-1995-alt", 1000, 1995)' />
                            </div>
                            
                            <div class="special-note-wrapper horizontal">
                                <div class="text-end pe-4">
                                    <h2 class="denomination-title">1000 ₽</h2>
                                    <span class="badge rounded-pill text-bg-light border text-secondary fw-medium px-3 py-2">
                                        @string.Format(L["SeriesFormat"].Value, 2023)
                                    </span>
                                </div>
                                <img src="/images/banknotes/rub-1000-2023-alt-reverse.jpg"
                                     class="special-note-img horizontal-note"
                                     alt="1000 Rubles 2023 Cancelled"
                                     @onclick='() => OpenSpecialNote("rub-1000-2023-alt", 1000, 2023)' />
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        }
    </div>
</div>

<BanknoteModal @bind-IsVisible="isNoteOpen" Banknote="selectedNote">
    <ChildContent>
        @((MarkupString)renderedHtml)
    </ChildContent>
</BanknoteModal>

@code {
    private bool isNoteOpen = false;
    private Banknote? selectedNote = null;
    private List<Banknote>? banknotes;
    private string renderedHtml = "";

    protected override void OnInitialized()
    {
        banknotes = Storage.GetBanknotes();
    }

    private async Task OpenBanknote(Banknote note)
    {
        selectedNote = note;
        var culture = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
        // Uses the ID from data.json (e.g., "rub-5-1997")
        var markdown = await ArticleService.GetArticleAsync("Banknotes", note.Name, culture);
        renderedHtml = Markdig.Markdown.ToHtml(markdown);
        isNoteOpen = true;
    }

    private async Task OpenSpecialNote(string name, int denomination, int year)
    {
        // Constructs a lightweight model to satisfy the modal binding and markdown fetcher
        var specialNote = new Banknote(name, denomination, year, "#f8f9fa", null, null);
        
        await OpenBanknote(specialNote);
    }
}